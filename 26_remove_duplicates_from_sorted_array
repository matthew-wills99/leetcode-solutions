class Solution:
    def removeDuplicates(self, nums: list[int]) -> int:
        if not nums:
            return 0

        k = 1                          # next slot to write a unique value
        for i in range(1, len(nums)):
            if nums[i] != nums[k - 1]: # differs from last unique value
                nums[k] = nums[i]
                k += 1

        return k